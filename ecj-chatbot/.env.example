# EuGH Chatbot Environment Variables

# Required: Anthropic API Key for Claude
ANTHROPIC_API_KEY=your-api-key-here

# =============================================================================
# DATA STORAGE (for Cloud Sync)
# =============================================================================

# Path to data directory - set this to a cloud-synced folder for multi-device access
# Examples:
#   Windows OneDrive: C:\Users\YourName\OneDrive\EuGH-Data
#   macOS OneDrive:   /Users/YourName/OneDrive/EuGH-Data
#   Google Drive:     /Users/YourName/Google Drive/EuGH-Data
#   Linux:            /home/yourname/Dropbox/EuGH-Data
#
# If not set, defaults to ./data in the project folder
# ECJ_DATA_DIR=/path/to/your/cloud/folder/EuGH-Data

# =============================================================================
# DOWNLOAD SETTINGS
# =============================================================================

# Year from which to download cases (default: 2018)
# ECJ_INITIAL_YEAR=2018

# Maximum number of cases for the initial download, newest first (default: 1500).
# Raise this if you want a larger corpus - the download takes correspondingly longer.
# ECJ_MAX_INITIAL_CASES=1500

# Topic corpora (comma-separated CELEX numbers of legal acts):
# For each act, ALL ECJ judgments citing it are downloaded - topic-complete,
# regardless of age, in addition to the recent corpus. Examples:
#   32016R0679  DSGVO / GDPR
#   31995L0046  Datenschutz-Richtlinie 95/46 (Vorgängerin der DSGVO)
#   32003L0088  Arbeitszeit-Richtlinie 2003/88
#   32000L0078  Gleichbehandlungsrahmen-Richtlinie 2000/78
#   32001L0023  Betriebsübergangs-Richtlinie 2001/23
# ECJ_TOPIC_CELEX=32016R0679,32003L0088

# =============================================================================
# MODEL SETTINGS
# =============================================================================

# Embedding model (default: multilingual MiniLM)
# ECJ_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Claude model for responses (default: claude-opus-4-8)
# ECJ_LLM_MODEL=claude-opus-4-8

# =============================================================================
# SEARCH SETTINGS
# =============================================================================

# Enable live fallback search for older cases (default: true)
# ECJ_ENABLE_LIVE_FALLBACK=true
